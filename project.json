{
  "name": "kirigami-studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "kirigami",
  "sourceRoot": "apps/kirigami-studio/src",
  "tags": [
    "skip-platform:android"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "shasum apps/kirigami-studio/uploads/gallery.json 2>/dev/null || echo no-gallery"
        }
      ],
      "options": {
        "styles": [
          "apps/kirigami-studio/src/styles.scss"
        ],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/kirigami-studio/public"
          },
          {
            "glob": "**/*",
            "input": "libs/ibid-ui/assets",
            "output": "."
          },
          {
            "glob": "**/*",
            "input": "apps/kirigami-studio/src/assets",
            "output": "/assets"
          },
          {
            "glob": "**/*",
            "input": "apps/kirigami-studio/uploads",
            "output": "/uploads"
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ]
        }
      }
    },
    "desktop": {},
    "desktop-build": {},
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4500
      }
    },
    "serve-e2e": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4501
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "kirigami-studio:build",
        "staticFilePath": "dist/kirigami-studio/browser",
        "spa": true
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "apps/kirigami-studio"
      }
    }
  }
}
