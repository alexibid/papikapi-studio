{
  "name": "papikapi-studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "papikapi-studio",
  "sourceRoot": "apps/papikapi-studio/src",
  "tags": ["skip-platform:android", "skip-platform:desktop"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "shasum apps/papikapi-api/public/models/index.json 2>/dev/null || echo no-index"
        }
      ],
      "options": {
        "styles": ["apps/papikapi-studio/src/styles.scss"],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/papikapi-studio/public"
          },
          {
            "glob": "**/*",
            "input": "apps/papikapi-api/public/models",
            "output": "/models"
          },
          {
            "glob": "**/*",
            "input": "libs/ibid-ui/assets",
            "output": "."
          },
          {
            "glob": "**/*",
            "input": "apps/papikapi-studio/src/assets",
            "output": "/assets"
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ]
        }
      }
    },
    "desktop": {},
    "desktop-build": {},
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4500,
        "proxyConfig": "apps/papikapi-studio/proxy.conf.json",
        "liveReload": false,
        "hmr": false
      }
    },
    "serve-app": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4500,
        "proxyConfig": "apps/papikapi-studio/proxy.conf.json",
        "liveReload": false,
        "hmr": false
      }
    },
    "serve-e2e": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4501
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "papikapi-studio:build",
        "staticFilePath": "dist/papikapi-studio/browser",
        "spa": true
      }
    }
  }
}
