{
  "name": "papikapi-studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "papikapi-studio",
  "sourceRoot": "apps/papikapi-studio/src",
  "tags": ["skip-platform:android", "skip-platform:desktop"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "shasum apps/papikapi-studio/public/models/index.json 2>/dev/null || echo no-index"
        }
      ],
      "options": {
        "styles": ["apps/papikapi-studio/src/styles.scss"],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/papikapi-studio/public"
          },
          {
            "glob": "**/*",
            "input": "libs/ibid-ui/assets",
            "output": "."
          },
          {
            "glob": "**/*",
            "input": "apps/papikapi-studio/src/assets",
            "output": "/assets"
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "700kb",
              "maximumError": "1.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ]
        }
      }
    },
    "desktop": {},
    "desktop-build": {},
    "serve-app": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4500,
        "proxyConfig": "apps/papikapi-studio/proxy.conf.json",
        "liveReload": false,
        "hmr": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run papikapi-studio:server",
          "npx nx run papikapi-studio:serve-app"
        ],
        "parallel": true
      }
    },
    "server": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx watch --clear-screen=false --exclude 'resources/**' --exclude 'public/**' scripts/server.ts",
        "cwd": "apps/papikapi-studio"
      }
    },
    "serve-e2e": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4501
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "papikapi-studio:build",
        "staticFilePath": "dist/papikapi-studio/browser",
        "spa": true
      }
    },
    "stages": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/stage-orchestrator.ts",
        "cwd": "apps/papikapi-studio"
      }
    },
    "lora:dataset": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/training/lora/lora-dataset-builder.ts",
        "cwd": "apps/papikapi-studio"
      }
    },
    "stage:1": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/stage-orchestrator.ts --stage 1",
        "cwd": "apps/papikapi-studio"
      }
    },
    "stage-1": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/stage-orchestrator.ts --stage 1",
        "cwd": "apps/papikapi-studio"
      }
    },
    "stage:1:step:1": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/stage-orchestrator.ts --stage 1 --step s1-step-1",
        "cwd": "apps/papikapi-studio"
      }
    },
    "stage-1:step-1": {
