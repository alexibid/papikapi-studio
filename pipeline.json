              "edge_inset_ratio": 0.01,
              "margin_ratio": 0.12,
              "sheet_thickness_ratio": 0.02,
              "sheet_gap_ratio": 0.015,
              "sheet_span_ratio": 1.3,
              "weld_epsilon": 1e-05,
              "fragment_min_triangles": 30,
              "fragment_min_thickness_ratio": 0.01,
              "plinth_hue_min_deg": 5,
              "plinth_hue_max_deg": 40,
              "plinth_min_saturation": 0.3,
              "plinth_min_value": 0.3
            }
          },
          "runner": {
            "platform": "RunPod Serverless",
            "device": "NVIDIA RTX 4090 Serverless Worker",
            "rate": "$0.00031/s ($1.10/hr active, $0.00 idle)"
