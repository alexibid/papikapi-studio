          "manifest_contract": {
            "status": "DONE",
            "seconds": "duration",
            "costUsd": "costUsd",
            "costNote": "RunPod Serverless ($0.00031/s)",
            "cache_cost_note": "Restored from local pick cache",
            "metrics": {
              "fileSize": "buffer.length",
              "faceCount": "result.output.face_count"
            },
            "data": {
              "fileSize": "buffer.length",
              "format": "model/gltf-binary",
              "chosenPick": "pick",
              "cached": false,
              "device": "NVIDIA RTX 4090 Serverless Worker",
              "parameters": {
                "seed": "seed",
                "resolution": "resolution",
                "decimation_target": "decimation_target",
                "texture_size": "texture_size"
              }
            }
          }
