{
  "system": "auto",
  "workspace": {
    "models_dir": "public/models",
    "resources_dir": "resources",
    "models_from": "resources/*/stage-1/step-2-art.jpeg",
    "sheet_language": "pt",
    "sheet_translations": "scripts/stage-4/sheet-translations.json"
  },
  "pricing": {
    "runpod_trellis_usd_per_sec": 0.00031,
    "runpod_flux_usd_per_sec": 0.00015,
    "local_processing_usd": 0.0,
    "flux_models": {
      "black-forest-labs/FLUX.2-klein-4B": 0.00015
    }
  },
  "pipeline_stages": [
    {
      "stage": "Stage 1: 3D Papercraft Figure Alternatives & Selection",
      "steps": [
        {
          "id": "s1-step-1",
          "name": "Alternatives Sheet Generation",
          "label": "ALTERNATIVES",
          "emoji": "🎨",
          "expected_seconds": 20,
          "script": "scripts/stage-1/step-1-alternatives.ts",
          "models_from": "resources/*/stage-1/step-2-art.jpeg",
          "skip_if_outputs_exist": true,
          "serverless": {
            "env_endpoint_key": "RUNPOD_FLUX_ENDPOINT_ID",
            "container_image": "ghcr.io/alexibid/papikapi-flux:latest",
            "min_workers": 0,
            "max_workers": 2,
            "idle_timeout_seconds": 5,
            "client_timeout_seconds": 900,
            "gpu_vram": "24GB",
            "api_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/runsync",
            "async_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/run",
            "status_url_pattern": "https://api.runpod.ai/v2/{endpoint_id}/status/{job_id}"
          },
          "parameters": {
            "default_model": "black-forest-labs/FLUX.2-klein-4B",
            "fallback_model": "black-forest-labs/FLUX.2-klein-4B",
            "inference_engine": "flux2-klein",
            "aspect_ratio": "3:2",
            "columns": 3,
            "rows": 2,
            "alternatives_count": 6,
            "max_reference_images": 3,
            "system_prompt": "The figure stands on one single flat plane of zero thickness, a plain sheet of matte {plane_colour} paper that contrasts strongly with every part of the figure touching it and casts no colour onto it, only slightly wider than the figure, never a slab, box or pedestal. Low-poly faceted 3D papercraft model of the subject described above, built from simple closed geometric volumes of matte cardstock with clean planar folds and no black crease lines. Every fine detail (eyes, nose, mouth, markings) is painted flat on the facets as a 2D decal, never sculpted. The mouth is always closed and painted flat: no open jaw, no teeth, no tongue. Blocky or voxel characters are exactly six plain rectangular blocks (head, torso, two arms, two legs) with perfectly flat faces, like a Minecraft skin: their hair, scarf and belt are flat pixel patterns printed on those faces, so hair over the shoulders is pixels on the front of the torso block, never built as an extra block or flap. Exactly the anatomy of the subject: no extra or missing legs, tails or eyes, no clothing or accessories. Cute expressive eyes with round white catchlights. No thin protruding parts: no strands, antennae or spikes. Eye-level three-quarter view with the camera at body height, the whole figure in frame and upright. Seamless flat light grey #E5E5E5 background. Zero shadows. No text, letters or watermark.",
            "reference_rule": "Use the reference photo only for the subject's colours and markings, never for its pose or camera angle.",
            "default_pose": "Standing on all its legs with every foot, paw or wheel flat on the plane and the belly raised off the plane, never sitting, crouching or lying down.",
            "plane_colours": [
              "white",
              "mid grey",
              "black",
              "blue",
              "red",
              "green",
              "orange",
              "purple"
            ]
          },
          "messages": {
            "start": "[Stage 1: Step 1] Generating 3x2 alternatives sheet for {model}",
            "completed": "[Stage 1: Step 1] Alternatives sheet generated in {duration}s"
          },
          "stage_dir": "stage-1",
          "outputs": {
            "sheet_resource": "step-1-alternatives.jpeg",
            "manifest": "step-1-manifest.json",
            "allowed_extensions": [
              ".jpeg",
              ".jpg",
              ".png",
              ".webp"
            ],
            "sheet_public": "alternatives.jpeg",
            "prompt_public": "prompt.txt",
            "public_url_pattern": "/models/{model}/alternatives.jpeg"
          },
          "manifest_contract": {
            "status": "DONE",
            "seconds": "duration",
            "costUsd": 0.00015,
            "costNote": "FLUX.2-klein-4B Inference ($0.00015)",
            "data": {
              "prompt": "prompt",
              "referenceCount": "referenceImages.length",
              "alternativesCount": 6,
              "format": "result.mime"
            }
          }
        },
        {
          "id": "s1-step-2",
          "name": "Pick & Crop Alternative",
          "label": "PICK",
          "emoji": "✂️",
          "expected_seconds": 1,
          "script": "scripts/stage-1/step-2-pick.ts",
          "stage_dir": "stage-1",
          "depends_on": {
            "step_id": "s1-step-1",
            "stage_dir": "stage-1"
          },
          "inputs": {
            "stage_dir": "stage-1",
            "sheet_resource": "step-1-alternatives.jpeg",
            "sheet_resource_prefix": "step-1-alternatives",
            "allowed_extensions": [
              ".jpeg",
              ".jpg",
              ".png",
              ".webp"
            ],
            "sheet_public": "alternatives.jpeg",
            "sheet_public_prefix": "alternatives"
          },
          "outputs": {
            "stage_dir": "stage-1",
            "art_resource": "step-2-art.jpeg",
            "manifest": "step-2-manifest.json",
            "allowed_extensions": [
              ".jpeg",
              ".jpg",
              ".png",
              ".webp"
            ],
            "art_public": "art.jpeg",
            "art_pick_resource_pattern": "step-2-art-pick-{pick}.jpeg",
            "art_pick_public_pattern": "art-pick-{pick}.jpeg",
            "public_url_pattern": "/models/{model}/art.jpeg"
          },
          "parameters": {
            "default_pick": 3,
            "jpeg_quality": 95,
            "columns": 3,
            "rows": 2
          },
          "messages": {
            "start": "[Stage 1: Step 2] Picking and cropping chosen alternative #{pick} for {model}",
            "completed": "[Stage 1: Step 2] Alternative #{pick} cropped and saved to step-2-art.jpeg in {duration}s"
          },
          "manifest_contract": {
            "status": "DONE",
            "seconds": "duration",
            "costUsd": 0.0,
            "costNote": "Local CPU Image Processing ($0.00)",
            "data": {
              "chosenPick": "pick",
              "artSize": "croppedBuffer.length"
            }
          }
        },
        {
          "id": "s1-step-3",
          "name": "TRELLIS Input",
          "label": "TRELLIS-IN",
          "emoji": "🖼️",
          "expected_seconds": 20,
          "script": "scripts/stage-1/step-3-trellis-input.ts",
          "stage_dir": "stage-1",
          "depends_on": {
            "step_id": "s1-step-2",
            "stage_dir": "stage-1"
          },
          "models_from": "resources/*/stage-1/step-2-art.jpeg",
          "inputs": {
            "stage_dir": "stage-1",
            "art_resource": "step-2-art.jpeg"
          },
          "outputs": {
            "stage_dir": "stage-1",
            "cutout_resource": "step-3-cutout.png",
            "trellis_input_resource": "step-3-trellis-input.png",
            "manifest": "step-3-manifest.json"
          },
          "parameters": {
            "python_script": "scripts/stage-1/python/trellis_input.py",
            "image_size": 1024,
            "plane_rgb": {
              "white": [245, 245, 245],
              "mid grey": [140, 140, 140],
              "black": [35, 35, 35],
              "blue": [30, 90, 220],
              "red": [210, 35, 35],
              "green": [40, 160, 60],
              "orange": [240, 130, 20],
              "purple": [130, 50, 180]
            },
            "super_resolution": {
              "binary": "~/.papikapi-tools/realesrgan-full/realesrgan-ncnn-vulkan",
              "model": "realesrgan-x4plus-anime",
              "scale": 4
            }
          },
          "messages": {
            "start": "[Stage 1: Step 3] Conditioning the chosen art as TRELLIS input for {model} (cutout, whiskers, white plinth, Real-ESRGAN x4, 1024)",
            "completed": "✔ [Stage 1: Step 3] TRELLIS input ready for {model} in {duration}s ($0.00)"
          },
          "manifest_contract": {
            "status": "DONE",
            "costUsd": 0.0,
            "costNote": "Local CPU Image Processing ($0.00)"
          }
        }
      ]
    },
    {
